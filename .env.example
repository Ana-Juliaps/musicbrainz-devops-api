# Copie para .env (nunca versione o .env real)
PORT=3000
LOG_LEVEL=info
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
# A MusicBrainz exige User-Agent identificável com contato
APP_CONTACT=seu.email@exemplo.com
# Intervalo mínimo entre chamadas à MusicBrainz (política: 1 req/s)
MB_MIN_INTERVAL_MS=1100
